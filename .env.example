# Kopiera den här filen till .env och fyll i dina nycklar.
# Lägg ALDRIG .env i versionshantering.

ANTHROPIC_API_KEY=sk-ant-...

# Skyddar GET /matning (driftdata). Saknas den svarar endpointen 503.
# Skicka som headern x-matning-nyckel. Generera t.ex. med:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MATNING_NYCKEL=

# Bolagsverkets API för värdefulla datamängder (OAuth2 client_credentials).
# Se kallor/kallregister.yaml → bolagsverket_hvd för token_url och scope.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
